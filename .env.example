# Copy this file to .env and change the values. Never commit the .env file.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./devinsight.db

# Generate your own value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value

# How long a login stays valid.
ACCESS_TOKEN_MINUTES=120

# Password given to the demonstration accounts by scripts/seed_demo.py.
SEED_PASSWORD=Training#2026
